# Copy to `.env` (do not commit .env)
# Frontend switch: 1 = call backend /api/scene, 0 = local fallback only.
VITE_USE_GEMINI=1

# Backend-only key (preferred for security).
GEMINI_API_KEY=your_gemini_api_key_here

# Backward-compatible fallback (older setup). Prefer GEMINI_API_KEY above.
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Imagen 4.0 (Vertex AI) – optional; without it, a placeholder background is used.
# VITE_GOOGLE_CLOUD_PROJECT=your-gcp-project
# VITE_VERTEX_REGION=us-central1
